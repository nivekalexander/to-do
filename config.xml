<?xml version='1.0' encoding='utf-8'?>
<widget id="com.kevin.todo" version="1.0.0" xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0">
  <name>To-Do</name>
  <description>Base tecnica Ionic Angular standalone con Apache Cordova.</description>
  <author email="kevin@example.com" href="https://example.com/">Kevin</author>
  <content src="index.html" />
  <access origin="*" />
  <allow-intent href="http://*/*" />
  <allow-intent href="https://*/*" />
  <allow-intent href="tel:*" />
  <allow-intent href="sms:*" />
  <allow-intent href="mailto:*" />
  <allow-intent href="geo:*" />
  <preference name="BackupWebStorage" value="none" />
  <preference name="ScrollEnabled" value="false" />
  <platform name="android">
    <preference name="android-minSdkVersion" value="24" />
    <allow-intent href="market:*" />
  </platform>
</widget>
